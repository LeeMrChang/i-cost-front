<view class="page">
  <view class="section-card user-card">
    <view class="flex-between">
      <view>
        <view class="hello">你好，{{user.name || 'iCost 用户'}}</view>
        <view class="text-muted">总资产 {{userView.totalAssets}}</view>
        <view class="text-muted mt-8">资金余额 {{userView.balance}}</view>
        <view class="switch-link" bindtap="goToAuth">切换账户 / 注册</view>
      </view>
      <image src="{{user.avatar || '/images/avatar.png'}}" class="avatar" mode="aspectFill"></image>
    </view>
    <view class="action-row">
      <button class="btn-primary" bindtap="goToBillForm">快速记账</button>
      <button class="btn-ghost" bindtap="goToLedger">账本列表</button>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">
      <text>账本总览</text>
      <picker
        class="ledger-picker"
        range="{{ledgerOptions}}"
        range-key="name"
        value="{{pickerIndex}}"
        bindchange="handleLedgerChange"
      >
        <view class="pill">{{ledgerOptions[pickerIndex].name}}</view>
      </picker>
    </view>
    <view class="ledger-stats">
      <view class="stat-item">
        <text class="text-muted">本月支出</text>
        <text class="amount">{{ledgerView.expense}}</text>
      </view>
      <view class="stat-item">
        <text class="text-muted">本月收入</text>
        <text class="amount green">{{ledgerView.income}}</text>
      </view>
      <view class="stat-item">
        <text class="text-muted">转账</text>
        <text class="amount">{{ledgerView.transfer}}</text>
      </view>
    </view>
    <view class="progress-row">
      <view class="text-muted">预算 {{ledgerView.budget}}</view>
      <view class="text-muted">剩余 {{ledgerView.budgetRemain}}</view>
    </view>
    <view class="progress">
      <view class="progress-inner" style="width: {{ledgerView.budgetUsage}}%;"></view>
    </view>
    <view class="sub-stat">
      <view>
        <view class="text-muted">结余</view>
        <view class="amount">{{ledgerView.balance}}</view>
      </view>
      <view>
        <view class="text-muted">待报销</view>
        <view class="amount orange">{{ledgerView.reimbursePending}}</view>
      </view>
      <view>
        <view class="text-muted">已报销</view>
        <view class="amount green">{{ledgerView.reimburseDone}}</view>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">
      <text>快捷统计</text>
      <button class="btn-ghost mini" bindtap="goToStatistics">更多</button>
    </view>
    <view class="quick-grid">
      <view class="quick-item">
        <text class="text-muted">支出</text>
        <text class="amount">{{totalsView.expense}}</text>
      </view>
      <view class="quick-item">
        <text class="text-muted">收入</text>
        <text class="amount green">{{totalsView.income}}</text>
      </view>
      <view class="quick-item">
        <text class="text-muted">结余</text>
        <text class="amount">{{totalsView.balance}}</text>
      </view>
      <view class="quick-item">
        <text class="text-muted">转账</text>
        <text class="amount">{{totalsView.transfer}}</text>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">
      <text>专题入口</text>
    </view>
    <view class="entry-row">
      <view class="entry" bindtap="goToBillForm">
        <text class="entry-title">添加账单</text>
        <text class="text-muted">支出/收入/转账</text>
      </view>
      <view class="entry" bindtap="goToIconManager">
        <text class="entry-title">图标管理</text>
        <text class="text-muted">收入/支出分类</text>
      </view>
    </view>
  </view>
</view>

