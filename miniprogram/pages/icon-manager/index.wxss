.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #f1f5f9;
  color: #607089;
}

.tab.active {
  background: #0abf88;
  color: #ffffff;
}

.icon-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.icon-item {
  display: flex;
  gap: 20rpx;
  align-items: center;
  background: #f7fafc;
  border-radius: 20rpx;
  padding: 20rpx;
}

.icon-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-thumb image {
  width: 60rpx;
  height: 60rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #6b7c93;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  background: #f7fafc;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

