<view class="page">
  <view class="section-card">
    <view class="tabs">
      <view
        class="tab {{activeTab === item.value ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="handleTabChange"
      >
        {{item.label}}
      </view>
    </view>
    <view class="icon-list">
      <view class="icon-item" wx:for="{{categories}}" wx:key="id">
        <view class="icon-thumb">
          <image src="{{item.icon}}" mode="aspectFit"></image>
        </view>
        <view class="icon-info">
          <view class="icon-name">{{item.name}}</view>
          <view class="text-muted">ID：{{item.id}}</view>
        </view>
      </view>
      <view class="text-muted" wx:if="{{!categories.length}}">暂未配置图标</view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">
      <text>新增图标</text>
    </view>
    <view class="form-item">
      <view class="form-label">图标名称</view>
      <input class="form-input" placeholder="例如：办公、外卖" value="{{form.name}}" data-field="name" bindinput="handleInput" />
    </view>
    <view class="form-item">
      <view class="form-label">icon 链接</view>
      <input class="form-input" placeholder="可输入线上地址或本地路径" value="{{form.icon}}" data-field="icon" bindinput="handleInput" />
    </view>
    <button class="btn-primary" bindtap="handleSubmit">保存图标</button>
  </view>
</view>

