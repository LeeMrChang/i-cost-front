.asset-main {
  text-align: center;
  margin-bottom: 24rpx;
}

.asset-amount {
  font-size: 48rpx;
  font-weight: 700;
  margin-top: 10rpx;
}

.asset-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #6b7c93;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  background: #f7fafc;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-item.half {
  flex: 1;
}

