<view class="page">
  <view class="section-card">
    <view class="section-title">
      <text>资产总览</text>
      <button class="btn-ghost mini" bindtap="toggleMask">{{mask ? '显示' : '隐藏'}}</button>
    </view>
    <view class="asset-main">
      <view class="text-muted">净资产</view>
      <view class="asset-amount">{{display.netAsset}}</view>
    </view>
    <view class="asset-grid">
      <view>
        <text class="text-muted">总资产</text>
        <text class="amount">{{display.totalAssets}}</text>
      </view>
      <view>
        <text class="text-muted">总负债</text>
        <text class="amount orange">{{display.totalDebt}}</text>
      </view>
      <view>
        <text class="text-muted">总借入</text>
        <text class="amount">{{display.borrowIn}}</text>
      </view>
      <view>
        <text class="text-muted">总借出</text>
        <text class="amount">{{display.borrowOut}}</text>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">
      <text>资产速调</text>
    </view>
    <view class="form-item">
      <view class="form-label">总资产 (¥)</view>
      <input
        class="form-input"
        type="number"
        value="{{form.totalAssets}}"
        data-field="totalAssets"
        bindinput="handleInput"
      />
    </view>
    <view class="form-item">
      <view class="form-label">总负债 (¥)</view>
      <input
        class="form-input"
        type="number"
        value="{{form.totalDebt}}"
        data-field="totalDebt"
        bindinput="handleInput"
      />
    </view>
    <view class="form-row">
      <view class="form-item half">
        <view class="form-label">总借入</view>
        <input
          class="form-input"
          type="number"
          value="{{form.borrowIn}}"
          data-field="borrowIn"
          bindinput="handleInput"
        />
      </view>
      <view class="form-item half">
        <view class="form-label">总借出</view>
        <input
          class="form-input"
          type="number"
          value="{{form.borrowOut}}"
          data-field="borrowOut"
          bindinput="handleInput"
        />
      </view>
    </view>
    <button class="btn-primary" bindtap="handleSave">保存调整</button>
  </view>
</view>

