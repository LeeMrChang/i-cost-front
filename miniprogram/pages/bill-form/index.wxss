.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #6b7c93;
  margin-bottom: 12rpx;
}

.form-input,
.form-textarea,
.picker-value {
  width: 100%;
  background: #f7fafc;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 160rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-item.half {
  flex: 1;
}

